    /* ===== AI SMART SYNONYM &amp; ANSWER CHECKING ===== */
    async function checkSynonymWithAI(userInput, targetWord, synonymsList = []) {
        const inputNorm = userInput.toLowerCase().trim();
        const targetNorm = targetWord.toLowerCase().trim();
        
        if (inputNorm === targetNorm) return { valid: true, type: 'exact' };

        const localSyns = (synonymsList || []).map(s =&gt; s.toLowerCase().trim());
        if (localSyns.includes(inputNorm)) {
            return { valid: true, type: 'synonym', word: inputNorm };
        }

        try {
            const res = await fetch(`https://api.datamuse.com/words?ml=${encodeURIComponent(targetNorm)}&amp;max=25`);
            if (res.ok) {
                const data = await res.json();
                if (Array.isArray(data)) {
                    const matched = data.find(item =&gt; item.word.toLowerCase().trim() === inputNorm);
                    if (matched) {
                        return { valid: true, type: 'ai_synonym', word: matched.word };
                    }
                }
            }
        } catch(e) {}

        return { valid: false };
    }

    /* ===== INLINE PRACTICE CHECK ===== */
    async function submitInlinePractice(id, inputEl) {
        const item = vocabList.find(v =&gt; v.id === id);
        if (!item || !isDue(item.nextReview)) return;

        const typed = inputEl.value.trim().toLowerCase();
        if (!typed) return;

        const checkRes = await checkSynonymWithAI(typed, item.word, item.synonyms);
        const badge = document.getElementById(`badge-${id}`);

        if (checkRes.valid) {
            inlineAttemptsMap[id] = 0;
            item.correctCount++;
            item.level++;
            
            let multiplier = item.difficulty === 'easy' ? 1.5 : (item.difficulty === 'hard' ? 0.5 : 1.0);
            const baseDays = [1, 3, 7, 14, 30][Math.min(item.level - 1, 4)] || 30;
            const days = Math.max(1, Math.round(baseDays * multiplier));
            
            const d = new Date(); d.setDate(d.getDate() + days);
            item.nextReview = d.toISOString().split('T')[0];

            inputEl.className = "practice-input correct";
            if (badge) { badge.className = "status-badge badge-true"; badge.innerText = "✓ Đúng"; }
            speak(item.word);

            if (checkRes.type === 'synonym' || checkRes.type === 'ai_synonym') {
                toast(`✨ Chính xác! "${typed}" là từ đồng nghĩa chuẩn!`);
            } else {
                toast("🎉 Chính xác! Từ đã được khoá đến lịch ôn tiếp theo.");
            }
            saveData();
        } else {
            inlineAttemptsMap[id] = (inlineAttemptsMap[id] || 0) + 1;
            inputEl.className = "practice-input incorrect";
            if (badge) { badge.className = "status-badge badge-false"; badge.innerText = "✗ Sai"; }
            
            toast("❌ Chưa đúng. Thử lại nhé!");

            const hintContainer = document.getElementById(`inline-hint-${id}`);
            if (inlineAttemptsMap[id] &gt;= 3) {
                const firstChar = item.word.charAt(0).toUpperCase();
                if (hintContainer) {
                    hintContainer.innerHTML = `💡 Gợi ý chữ cái đầu: &lt;b&gt;${firstChar}...&lt;/b&gt; &lt;button class="trans-btn" style="color:#FF2E63;" onclick="alert('Đáp án đúng là: ${item.word}')"&gt;👁️ Xem đáp án&lt;/button&gt;`;
                }
            }
        }
    }

