        },
        {
            id: 2,
            word: "abide by",
            ipa: "/əˈbaɪd baɪ/",
            pos: "verb",
            meaningVi: "tuân theo, tôn trọng (luật/quy định)",
            synonyms: ["comply with", "adhere to", "follow", "obey"],
            collocations: [
                { 
                    phrase: "abide by the rules", 
                    example: "All members must abide by the rules.",
                    exampleVi: "Tất cả các thành viên phải tuân theo các quy tắc." 
                },
                { 
                    phrase: "abide by the decision", 
                    example: "We agree to abide by the judge's decision.",
                    exampleVi: "Chúng tôi đồng ý tuân theo quyết định của thẩm phán." 
                }
            ],
            example: "All members must abide by the organization's regulations.",
            exampleVi: "Tất cả thành viên phải tuân theo các quy định của tổ chức.",
            correctCount: 0,
            wrongCount: 0,
            level: 0,
            nextReview: new Date().toISOString().split('T')[0],
            register: "Formal",
