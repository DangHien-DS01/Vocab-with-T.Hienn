    /* ===== CHECK SMART REVIEW WITH WRITING CO-PILOT ===== */
    async function checkSmartReview() {
        if (reviewAnswered) {
            nextSmartReview();
            return;
        }

        const typed = document.getElementById('review-input').value.trim();
        if (!typed) return;

        document.getElementById('review-ai-checking').style.display = 'flex';
        document.getElementById('review-check-btn').classList.add('hidden');

        if (currentReviewMode === 'writing') {
            const hasWord = typed.toLowerCase().includes(currentReviewItem.word.toLowerCase());
            const wordCount = typed.split(/\s+/).length;

            document.getElementById('review-ai-checking').style.display = 'none';

            if (hasWord &amp;&amp; wordCount &gt;= 4) {
                reviewAnswered = true;
                currentReviewItem.correctCount++;
                currentReviewItem.level++;
                saveData();

                document.getElementById('review-feedback').innerHTML = `&lt;span class="review-good"&gt;✨ Tuyệt vời! Câu của bạn rất tự nhiên và áp dụng đúng ngữ cảnh từ "${currentReviewItem.word}"!&lt;/span&gt;`;
                document.getElementById('review-answer-hint').innerText = `Câu đã đặt: "${typed}"`;
                
                document.getElementById('review-input').readOnly = true;
                document.getElementById('review-next-btn').classList.remove('hidden');
                speak(typed);
                return;
            } else {
                document.getElementById('review-feedback').innerHTML = `&lt;span class="review-bad"&gt;⚠️ Câu của bạn phải chứa từ "${currentReviewItem.word}" và có ít nhất 4 từ!&lt;/span&gt;`;
                document.getElementById('review-retry-btn').classList.remove('hidden');
                document.getElementById('review-skip-btn').classList.remove('hidden');
                return;
            }
        }

        const checkRes = await checkSynonymWithAI(typed, currentReviewItem.word, currentReviewItem.synonyms);
        document.getElementById('review-ai-checking').style.display = 'none';

        if (checkRes.valid) {
            reviewAnswered = true;
            currentReviewItem.correctCount++;
            currentReviewItem.level++;
            
            let multiplier = currentReviewItem.difficulty === 'easy' ? 1.5 : (currentReviewItem.difficulty === 'hard' ? 0.5 : 1.0);
            const baseDays = [1, 3, 7, 14, 30][Math.min(currentReviewItem.level - 1, 4)] || 30;
            const days = Math.max(1, Math.round(baseDays * multiplier));
            
            const d = new Date(); d.setDate(d.getDate() + days);
            currentReviewItem.nextReview = d.toISOString().split('T')[0];

            if (checkRes.type === 'synonym' || checkRes.type === 'ai_synonym') {
                document.getElementById('review-feedback').innerHTML = `&lt;span class="review-good"&gt;✨ Chính xác! "${typed}" là từ đồng nghĩa chuẩn!&lt;/span&gt;`;
                document.getElementById('review-answer-hint').innerText = `(Từ gốc trong bài: "${currentReviewItem.word}")`;
            } else {
                document.getElementById('review-feedback').innerHTML = '&lt;span class="review-good"&gt;🎉 CHÍNH XÁC! Nhấn ENTER để tiếp tục!&lt;/span&gt;';
            }

            speak(currentReviewItem.word);
            saveData();

            document.getElementById('review-input').readOnly = true;
            document.getElementById('review-retry-btn').classList.add('hidden');
            document.getElementById('review-skip-btn').classList.add('hidden');
            document.getElementById('review-next-btn').classList.remove('hidden');

            if (reviewIndex === reviewQueue.length - 1) {
                document.getElementById('review-next-btn').innerText = "HOÀN THÀNH (ENTER) ✓";
            } else {
                document.getElementById('review-next-btn').innerText = "TIẾP TỤC (ENTER) →";
            }
        } else {
            reviewWrongAttempts++;
            document.getElementById('review-feedback').innerHTML = '&lt;span class="review-bad"&gt;❌ CHƯA ĐÚNG! Bạn hãy thử suy nghĩ và gõ lại nhé&lt;/span&gt;';
            
            if (reviewWrongAttempts &gt;= 3) {
                const firstChar = currentReviewItem.word.charAt(0).toUpperCase();
                document.getElementById('review-answer-hint').innerText = `💡 Gợi ý chữ cái đầu: "${firstChar}..."`;
            }

            document.getElementById('review-retry-btn').classList.remove('hidden');
            document.getElementById('review-skip-btn').classList.remove('hidden');
            document.getElementById('review-check-btn').classList.add('hidden');
        }
    }

    function retrySmartReview() {
        document.getElementById('review-feedback').innerText = '';
        if (reviewWrongAttempts &lt; 3) {
            document.getElementById('review-answer-hint').innerText = '';
        }
        document.getElementById('review-retry-btn').classList.add('hidden');
        document.getElementById('review-skip-btn').classList.add('hidden');
        document.getElementById('review-check-btn').classList.remove('hidden');

        const inputEl = document.getElementById('review-input');
        inputEl.readOnly = false;
        inputEl.focus();
        inputEl.select();
    }

    function skipSmartReview() {
        reviewAnswered = true;
        currentReviewItem.wrongCount++;
        currentReviewItem.level = Math.max(0, currentReviewItem.level - 1);
        currentReviewItem.nextReview = getTodayStr();

        document.getElementById('review-feedback').innerHTML = '&lt;span class="review-bad"&gt;❌ ĐÃ BỎ QUA CÂU HỎI NÀY!&lt;/span&gt;';
        document.getElementById('review-answer-hint').innerText = `Đáp án chuẩn: "${currentReviewItem.word}"`;

        saveData();

        document.getElementById('review-input').readOnly = true;
        document.getElementById('review-retry-btn').classList.add('hidden');
        document.getElementById('review-skip-btn').classList.add('hidden');
        document.getElementById('review-check-btn').classList.add('hidden');
        document.getElementById('review-next-btn').classList.remove('hidden');

        if (reviewIndex === reviewQueue.length - 1) {
            document.getElementById('review-next-btn').innerText = "HOÀN THÀNH (ENTER) ✓";
        } else {
            document.getElementById('review-next-btn').innerText = "TIẾP TỤC (ENTER) →";
        }
    }

    function nextSmartReview() {
        reviewIndex++;
        if (reviewIndex &gt;= reviewQueue.length) {
            document.getElementById('review-prompt').innerText = "🎉 Hoàn thành xuất sắc bài ôn tập!";
            document.getElementById('review-feedback').innerHTML = '&lt;span class="review-good"&gt;Tất cả từ đã ôn đã được cập nhật lịch học tiếp theo.&lt;/span&gt;';
            document.getElementById('review-next-btn').classList.add('hidden');
            document.getElementById('review-close-btn').classList.remove('hidden');
            document.getElementById('review-input').classList.add('hidden');
            document.getElementById('review-audio-btn').classList.add('hidden');
            return;
        }
        showReviewQuestion();
    }

    function closeReview() {
        document.getElementById('review-modal').style.display = 'none';
        document.getElementById('review-input').classList.remove('hidden');
        renderTables();
    }

    function deleteWord(id) {
        if (confirm("Bạn có chắc muốn xóa từ vựng này khỏi danh sách?")) {
            vocabList = vocabList.filter(v =&gt; v.id !== id);
            saveData();
            toast("Đã xóa từ vựng.");
        }
    }

    /* ===== LẮNG NGHE PHÍM ENTER CHO MODAL ÔN TẬP ===== */
    document.addEventListener('keydown', function(event) {
        const reviewModal = document.getElementById('review-modal');
        if (reviewModal &amp;&amp; reviewModal.style.display === 'flex' &amp;&amp; event.key === 'Enter') {
            event.preventDefault();
            handleReviewEnter();
        }
    });

    /* ===== STATS ===== */
    function openStats() {
        document.getElementById('stat-total-words').innerText = vocabList.length;
        const mastered = vocabList.filter(v =&gt; calculateMemoryScore(v) &gt;= 95 || v.level &gt;= 5).length;
        document.getElementById('stat-mastered-words').innerText = mastered;
        
        let totalC = 0, totalW = 0;
        vocabList.forEach(v =&gt; { totalC += v.correctCount; totalW += v.wrongCount; });
        const acc = (totalC + totalW) ? Math.round((totalC / (totalC + totalW)) * 100) : 0;
        
        document.getElementById('stat-accuracy').innerText = `${acc}%`;
        document.getElementById('stat-total-reviews').innerText = totalC + totalW;

        document.getElementById('stats-modal').style.display = 'flex';
    }

    function closeStats() { document.getElementById('stats-modal').style.display = 'none'; }

    renderTables();
