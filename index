    &lt;style&gt;
        /* ==========================================================================
           OCEAN MAGICAL &amp; CUTE MASCOT THEME (DESIGNED BY SENIOR UX/FRONT-END)
           ========================================================================== */
        :root {
            /* OCEAN &amp; SKY COLOR PALETTE */
            --ocean-dark: #0077B6;
            --ocean-main: #0096C7;
            --ocean-light: #00B4D8;
            --sky-blue: #48CAE4;
            --glacier-cyan: #90E0EF;
            --ice-foam: #E0F7FA;
            --magic-purple: #9D4EDD;
            --magic-pink: #FF85A1;
            --star-gold: #FFD166;
            --mint-green: #2EC4B6;
            --soft-mint: #E8FCCF;
            
            /* GLASSMORPHISM &amp; TEXT */
            --card-glass: rgba(255, 255, 255, 0.82);
            --card-glass-glow: rgba(144, 224, 239, 0.4);
            --text-main: #0B2545;
            --text-sub: #486581;
            --border-magic: rgba(72, 202, 228, 0.45);
            
            /* SHADOWS &amp; RADIUS */
            --shadow-magical: 0 12px 35px rgba(0, 119, 182, 0.18), 0 0 25px rgba(144, 224, 239, 0.35);
            --shadow-hover: 0 16px 40px rgba(0, 150, 199, 0.3), 0 0 30px rgba(255, 209, 102, 0.5);
            --radius-lg: 28px;
            --radius-md: 20px;
            --radius-sm: 12px;
        }

        * { box-sizing: border-box; font-family: 'Nunito', -apple-system, sans-serif; margin: 0; padding: 0; }
        
        /* BACKGROUND &amp; FLOATING MASCOTS */
        body {
            background: linear-gradient(135deg, #A2D2FF 0%, #C8B6FF 35%, #B8C0FF 65%, #E7C6FF 100%);
            background-attachment: fixed;
            color: var(--text-main);
            padding: 24px 16px;
            min-height: 100vh;
            position: relative;
            overflow-x: hidden;
        }

        /* FLOATING MAGICAL MASCOTS IN BACKGROUND */
        body::before {
            content: "🦄";
            position: fixed;
            top: 40px;
            left: 20px;
            font-size: 55px;
            filter: drop-shadow(0 10px 15px rgba(0,0,0,0.15));
            animation: floatMascot 6s ease-in-out infinite alternate;
            pointer-events: none;
            z-index: 0;
        }

        body::after {
            content: "🐱🌈";
            position: fixed;
            bottom: 30px;
            right: 25px;
            font-size: 50px;
            filter: drop-shadow(0 10px 15px rgba(0,0,0,0.15));
            animation: floatMascot 7s ease-in-out infinite alternate-reverse;
            pointer-events: none;
            z-index: 0;
        }

        @keyframes floatMascot {
            0% { transform: translateY(0px) rotate(-5deg) scale(1); }
            50% { transform: translateY(-20px) rotate(5deg) scale(1.08); }
            100% { transform: translateY(-10px) rotate(-3deg) scale(1.02); }
        }

        /* MAIN GLASS CONTAINER */
        .container {
            position: relative;
            z-index: 1;
            max-width: 1550px;
            margin: 0 auto;
            background: var(--card-glass);
            backdrop-filter: blur(20px) saturate(180%);
            -webkit-backdrop-filter: blur(20px) saturate(180%);
            padding: 32px;
            border-radius: var(--radius-lg);
            border: 2px solid rgba(255, 255, 255, 0.8);
            box-shadow: var(--shadow-magical), inset 0 0 20px rgba(255, 255, 255, 0.7);
        }

        /* ===== ACTIVE RECALL BLUR EFFECT ===== */
        .blur-word {
            filter: blur(7px);
            transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
            cursor: pointer;
            user-select: none;
            border-radius: 8px;
            background: rgba(144, 224, 239, 0.25);
            padding: 2px 8px;
            display: inline-block;
        }

        .blur-word:hover, .blur-word.revealed {
            filter: blur(0) !important;
            user-select: auto;
            background: rgba(255, 209, 102, 0.3);
            box-shadow: 0 0 12px rgba(255, 209, 102, 0.6);
        }

        /* ===== FLOATING ACTION BUTTON ===== */
        .floating-add-btn {
            position: absolute;
            z-index: 10000;
            background: linear-gradient(135deg, #00B4D8, #9D4EDD);
            color: white;
            border: 2px solid #FFFFFF;
            padding: 10px 20px;
            border-radius: 50px;
            font-size: 13px;
            font-weight: 800;
            box-shadow: 0 10px 25px rgba(0, 180, 216, 0.4), 0 0 15px rgba(255, 209, 102, 0.6);
            cursor: pointer;
            display: none;
            align-items: center;
            gap: 8px;
            transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
            animation: popUp 0.25s ease-out;
        }

        .floating-add-btn:hover {
            transform: scale(1.1) rotate(2deg);
            background: linear-gradient(135deg, #0077B6, #FF85A1);
        }

        @keyframes popUp {
            from { opacity: 0; transform: scale(0.8) translateY(8px); }
            to { opacity: 1; transform: scale(1) translateY(0); }
        }

        /* ===== HEADER &amp; ACTION BAR ===== */
        .header-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 16px;
            margin-bottom: 24px;
        }

        .title-group {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .title-group h1 {
            font-size: 32px;
            font-weight: 900;
            background: linear-gradient(45deg, #0077B6, #00B4D8, #9D4EDD);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            letter-spacing: -0.5px;
            position: relative;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .title-group h1::after {
            content: "🐬";
            font-size: 28px;
            -webkit-text-fill-color: initial;
            animation: floatMascot 4s ease-in-out infinite;
        }

        .sparkle-badge {
            background: linear-gradient(135deg, #FFD166, #FF85A1);
            color: #0B2545;
            padding: 8px 18px;
            border-radius: 30px;
            font-size: 13px;
            font-weight: 900;
            box-shadow: 0 4px 15px rgba(255, 209, 102, 0.5);
            animation: pulse-magic 2s infinite ease-in-out;
            border: 2px solid #FFFFFF;
        }

        @keyframes pulse-magic {
            0%, 100% { transform: scale(1); box-shadow: 0 4px 15px rgba(255, 209, 102, 0.5); }
            50% { transform: scale(1.06); box-shadow: 0 6px 22px rgba(255, 209, 102, 0.8), 0 0 15px rgba(72, 202, 228, 0.6); }
        }

        .header-actions {
            display: flex;
            gap: 12px;
            flex-wrap: wrap;
        }

        /* ===== BUTTON STYLES ===== */
        .btn {
            padding: 12px 22px;
            border: none;
            border-radius: 50px;
            font-weight: 800;
            font-size: 14px;
            cursor: pointer;
            transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            box-shadow: 0 4px 12px rgba(0, 119, 182, 0.12);
        }

        .btn:hover {
            transform: translateY(-4px) scale(1.03);
            box-shadow: var(--shadow-hover);
        }

        .btn-main-review {
            background: linear-gradient(135deg, #0096C7, #9D4EDD);
            color: white;
            font-size: 16px;
            padding: 14px 28px;
            box-shadow: 0 8px 25px rgba(0, 150, 199, 0.4);
            border: 2px solid rgba(255, 255, 255, 0.6);
            position: relative;
            overflow: hidden;
        }

        .btn-main-review::before {
            content: "✨";
            position: absolute;
            top: -5px;
            right: 10px;
            font-size: 14px;
            opacity: 0.8;
        }

        .btn-ai-add {
            background: linear-gradient(135deg, #00B4D8, #FFD166);
            color: #0B2545;
            border: 2px solid #FFFFFF;
        }

        .btn-sub {
            background: rgba(255, 255, 255, 0.9);
            color: var(--text-main);
            border: 2px solid var(--glacier-cyan);
        }

        .btn-sub:hover {
            background: var(--ice-foam);
            border-color: var(--ocean-light);
        }

        /* ===== DAILY GOAL TRACKER ===== */
        .daily-bar {
            background: linear-gradient(135deg, rgba(224, 247, 250, 0.9), rgba(200, 182, 255, 0.4));
            border: 2px dashed #48CAE4;
            border-radius: var(--radius-md);
            padding: 18px 24px;
            margin-bottom: 28px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 16px;
            box-shadow: inset 0 0 15px rgba(255,255,255,0.8);
            position: relative;
        }

        .daily-bar::after {
            content: "🪼";
            position: absolute;
            right: -10px;
            top: -15px;
            font-size: 26px;
        }

        .daily-info {
            display: flex;
            align-items: center;
            gap: 18px;
            font-weight: 800;
            font-size: 15px;
            color: #0B2545;
        }

        .daily-progress-bg {
            flex: 1;
            max-width: 320px;
            height: 16px;
            background: rgba(255, 255, 255, 0.8);
            border-radius: 20px;
            overflow: hidden;
            border: 2px solid var(--sky-blue);
            padding: 2px;
        }

        .daily-progress-fill {
            height: 100%;
            width: 0%;
            background: linear-gradient(90deg, #48CAE4, #2EC4B6, #FFD166);
            border-radius: 20px;
            transition: width 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
            box-shadow: 0 0 10px rgba(72, 202, 228, 0.8);
        }

        /* ===== ADD WORD AREA ===== */
        .add-word-card {
            background: rgba(255, 255, 255, 0.92);
            border: 2px solid var(--sky-blue);
            border-radius: var(--radius-md);
            padding: 24px;
            margin-bottom: 32px;
            box-shadow: var(--shadow-magical);
            position: relative;
        }

        .add-word-card::before {
            content: "🪄";
            position: absolute;
            top: -12px;
            left: 24px;
            font-size: 22px;
            background: #FFFFFF;
            padding: 0 6px;
            border-radius: 10px;
        }

        .add-word-title {
            font-size: 17px;
            font-weight: 900;
            color: var(--ocean-dark);
            margin-bottom: 14px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .add-input-group {
            display: flex;
            gap: 14px;
            position: relative;
        }

        input[type="text"], select.custom-select {
            flex: 1;
            padding: 14px 22px;
            border: 2px solid var(--glacier-cyan);
            border-radius: 50px;
            font-size: 15px;
            font-weight: 800;
            outline: none;
            transition: all 0.25s;
            background: rgba(240, 248, 255, 0.6);
            color: var(--text-main);
        }

        input[type="text"]:focus, select.custom-select:focus {
            border-color: var(--ocean-main);
            background: #FFFFFF;
            box-shadow: 0 0 0 5px rgba(72, 202, 228, 0.25);
        }

        /* AI PREVIEW CARD */
        .ai-preview-card {
            display: none;
            margin-top: 20px;
            background: linear-gradient(135deg, #E0F7FA, #FFFFFF);
            border: 2px solid var(--ocean-light);
            border-radius: var(--radius-md);
            padding: 24px;
            animation: fadeIn 0.35s ease-in-out;
            box-shadow: 0 10px 25px rgba(0, 180, 216, 0.15);
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(-10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .ai-word-header {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 14px;
            flex-wrap: wrap;
        }

        .ai-word-name { font-size: 26px; font-weight: 900; color: var(--ocean-dark); }
        .ai-ipa { font-size: 15px; font-weight: 800; color: var(--magic-purple); background: rgba(200, 182, 255, 0.4); padding: 5px 12px; border-radius: 20px; }
        .ai-pos { font-size: 12px; font-weight: 900; text-transform: uppercase; background: var(--soft-mint); color: #15803D; padding: 5px 12px; border-radius: 20px; }

        .ai-details-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
            gap: 14px;
            font-size: 14px;
            margin-bottom: 20px;
        }

        .ai-detail-box {
            background: rgba(255,255,255,0.95);
            padding: 14px;
            border-radius: var(--radius-sm);
            border: 1px solid var(--sky-blue);
            box-shadow: 0 4px 10px rgba(0,119,182,0.05);
        }

        .ai-detail-title { font-size: 11px; font-weight: 900; color: var(--text-sub); text-transform: uppercase; margin-bottom: 6px; }

        /* BADGES &amp; TAGS */
        .register-badge { display: inline-block; padding: 3px 10px; border-radius: 12px; font-size: 11px; font-weight: 800; text-transform: uppercase; margin-left: 6px; }
        .reg-academic { background: #E0F2FE; color: #0369A1; }
        .reg-formal { background: #F3E8FF; color: #6B21A8; }
        .reg-informal { background: #FEF3C7; color: #92400E; }

        .topic-tag { display: inline-block; background: var(--ice-foam); color: var(--ocean-dark); font-size: 11px; font-weight: 800; padding: 3px 10px; border-radius: 12px; margin-right: 4px; margin-top: 6px; border: 1px solid var(--sky-blue); }

        /* ===== TABLE STYLES ===== */
        .table-section-title {
            font-size: 20px;
            font-weight: 900;
            color: var(--ocean-dark);
            margin-bottom: 16px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .search-filter-bar {
            display: flex;
            gap: 14px;
            margin-bottom: 20px;
            flex-wrap: wrap;
        }

        .search-filter-bar input { flex: 1; min-width: 220px; }
        .search-filter-bar select {
            padding: 12px 20px;
            border: 2px solid var(--glacier-cyan);
            border-radius: 50px;
            font-size: 14px;
            font-weight: 800;
            outline: none;
            background: #FFFFFF;
            cursor: pointer;
            color: var(--text-main);
        }

        .table-container {
            overflow-x: auto;
            border-radius: var(--radius-md);
            border: 2px solid var(--sky-blue);
            background: rgba(255, 255, 255, 0.95);
            box-shadow: var(--shadow-magical);
        }

        table {
            width: 100%;
            border-collapse: collapse;
            font-size: 14px;
            min-width: 1250px;
        }

        th {
            background: linear-gradient(135deg, #0077B6, #0096C7);
            color: #FFFFFF;
            padding: 16px;
            font-weight: 900;
            text-align: left;
            font-size: 12px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            border-bottom: 3px solid var(--sky-blue);
        }

        td {
            padding: 16px;
            border-bottom: 1px solid #E0F2FE;
            vertical-align: top;
        }

        tr:hover { background-color: rgba(224, 247, 250, 0.6); }
        tr.due-row { background-color: rgba(255, 235, 238, 0.6) !important; }
        tr.due-row td:first-child { border-left: 6px solid #FF4D6D; }

        .word-cell { font-size: 18px; font-weight: 900; color: #0077B6; }
        .ipa-tag { font-size: 13px; font-weight: 800; color: var(--magic-purple); font-family: monospace; }
        .speaker-btn { background: none; border: none; cursor: pointer; font-size: 18px; margin-left: 6px; transition: transform 0.2s; }
        .speaker-btn:hover { transform: scale(1.3) rotate(10deg); }

        .synonym-chip { display: inline-block; background: #E0F2FE; color: #0284C7; font-size: 11px; font-weight: 800; padding: 3px 9px; border-radius: 12px; margin-top: 4px; margin-right: 4px; border: 1px solid #BAE6FD; }
        
        .collo-box { margin-top: 10px; font-size: 12px; background: rgba(224, 247, 250, 0.8); padding: 10px 12px; border-radius: 14px; border: 1px solid #90E0EF; }
        .collo-item { margin-top: 6px; }
        .collo-item:first-child { margin-top: 0; }
        .collo-phrase { font-weight: 900; color: #0077B6; }
        .collo-ex { font-size: 11px; color: #334155; font-style: italic; display: inline-block; margin-top: 2px; }

        .pos-badge { display: inline-block; padding: 5px 12px; border-radius: 20px; font-size: 11px; font-weight: 900; text-transform: uppercase; }
        .pos-noun { background: #E0F2FE; color: #0369A1; }
        .pos-verb { background: #DCFCE7; color: #15803D; }
        .pos-adj { background: #FEF3C7; color: #B45309; }
        .pos-adv { background: #FCE7F3; color: #BE185D; }
        .pos-other { background: #F1F5F9; color: #475569; }

        .practice-input {
            width: 100%;
            padding: 10px 14px;
            border: 2px solid var(--glacier-cyan);
            border-radius: 14px;
            font-size: 13px;
            font-weight: 800;
            outline: none;
            transition: all 0.2s ease;
            background: #FFFFFF;
        }

        .practice-input:focus { border-color: var(--ocean-main); box-shadow: 0 0 0 3px rgba(72, 202, 228, 0.3); }

        .practice-input:disabled {
            background-color: #F1F5F9;
            color: #94A3B8;
            cursor: not-allowed;
            border-color: #E2E8F0;
        }

        .practice-input.correct { border-color: #38B000; background-color: #E8FCCF; color: #15803D; }
        .practice-input.incorrect { border-color: #FF4D6D; background-color: #FFF0F3; color: #B91C1C; }

        .status-badge { display: inline-block; padding: 5px 12px; border-radius: 20px; font-weight: 900; font-size: 11px; }
        .badge-true { background: #DCFCE7; color: #15803D; }
        .badge-false { background: #FEE2E2; color: #B91C1C; }
        .badge-pending { background: #E0F7FA; color: #0077B6; }
        .badge-locked { background: #E2E8F0; color: #64748B; }

        .next-review-tag {
            font-size: 12px;
            font-weight: 800;
            padding: 6px 12px;
            border-radius: 20px;
            display: inline-block;
        }
        .tag-due-today { background: #FFE5EC; color: #FF2E63; border: 1px solid #FF7597; }
        .tag-future { background: #E0F2FE; color: #0284C7; border: 1px solid #BAE6FD; }

        .progress-bar-bg { width: 100%; background: #E2E8F0; border-radius: 10px; height: 10px; overflow: hidden; margin: 6px 0; }
        .progress-bar-fill { height: 100%; border-radius: 10px; transition: width 0.4s ease; }

        .mem-tag { display: inline-block; font-size: 11px; font-weight: 900; padding: 4px 10px; border-radius: 12px; margin-top: 4px; }
        .mem-tag-low { background: #FEE2E2; color: #991B1B; } 
        .mem-tag-mid { background: #FEF3C7; color: #92400E; } 
        .mem-tag-good { background: #DCFCE7; color: #166534; } 
        .mem-tag-master { background: #F3E8FF; color: #6B21A8; box-shadow: 0 0 10px rgba(157, 78, 221, 0.4); } 

        .example-box { font-size: 14px; max-width: 360px; line-height: 1.5; }
        .highlight-word { color: #0077B6; font-weight: 900; background: rgba(144, 224, 239, 0.3); padding: 1px 6px; border-radius: 6px; }
        .trans-btn { background: var(--ice-foam); color: var(--ocean-dark); border: 1px solid var(--sky-blue); padding: 3px 10px; border-radius: 10px; font-size: 11px; font-weight: 800; cursor: pointer; margin-left: 6px; }
        .trans-btn:hover { background: var(--sky-blue); color: white; }
        .trans-text { display: none; margin-top: 6px; font-size: 12px; color: #0077B6; background: rgba(224, 247, 250, 0.9); padding: 8px 12px; border-radius: 10px; border: 1px solid var(--sky-blue); }

        .delete-btn { color: #94A3B8; background: none; border: none; cursor: pointer; font-size: 20px; transition: color 0.2s; }
        .delete-btn:hover { color: #FF4D6D; transform: scale(1.2); }

        /* SPEED CONTROLLER UI */
        .speed-control-bar { display: inline-flex; gap: 4px; background: #E0F2FE; padding: 3px 8px; border-radius: 20px; margin-left: 8px; border: 1px solid #BAE6FD; }
        .speed-btn { border: none; background: transparent; font-size: 11px; font-weight: 800; padding: 3px 8px; border-radius: 10px; cursor: pointer; color: #0369A1; }
        .speed-btn.active { background: #0096C7; color: white; box-shadow: 0 2px 6px rgba(0, 150, 199, 0.4); }

        /* ===== MODAL &amp; OVERLAY ===== */
        .modal-backdrop {
            position: fixed;
            inset: 0;
            background: rgba(11, 37, 69, 0.6);
            backdrop-filter: blur(10px);
            display: none;
            align-items: center;
            justify-content: center;
            z-index: 9999;
            padding: 16px;
        }

        .modal {
            background: rgba(255, 255, 255, 0.96);
            border-radius: var(--radius-lg);
            padding: 32px;
            width: min(640px, 100%);
            box-shadow: 0 25px 60px rgba(0, 119, 182, 0.35), 0 0 30px rgba(144, 224, 239, 0.5);
            border: 3px solid var(--sky-blue);
            max-height: 90vh;
            overflow-y: auto;
            position: relative;
        }

        .modal::before {
            content: "🔮";
            position: absolute;
            top: 20px;
            left: 24px;
            font-size: 30px;
        }

        .modal-close-x {
            position: absolute;
            top: 18px;
            right: 22px;
            background: #E0F7FA;
            color: var(--ocean-dark);
            border: 2px solid var(--sky-blue);
            font-size: 18px;
            font-weight: 900;
            width: 38px;
            height: 38px;
            border-radius: 50%;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.2s;
        }

        .modal-close-x:hover {
            background: #FF4D6D;
            color: white;
            border-color: #FF4D6D;
            transform: scale(1.1) rotate(90deg);
        }

        .modal h2 { font-size: 24px; font-weight: 900; color: var(--ocean-dark); margin-bottom: 12px; padding-left: 36px; }

        /* REVIEW MODAL SPECIFIC */
        .review-modal { text-align: center; }
        .review-progress-bar { height: 10px; background: #E0F2FE; border-radius: 10px; overflow: hidden; margin-bottom: 16px; border: 1px solid var(--sky-blue); }
        .review-progress-fill { height: 100%; width: 0%; background: linear-gradient(90deg, #48CAE4, #0096C7, #9D4EDD); transition: width 0.4s; }
        .review-counter { font-size: 14px; font-weight: 900; color: var(--text-sub); }
        
        .mode-badge {
            display: inline-block;
            background: linear-gradient(135deg, #0096C7, #9D4EDD);
            color: white;
            font-size: 12px;
            font-weight: 900;
            padding: 6px 16px;
            border-radius: 20px;
            margin-top: 8px;
            text-transform: uppercase;
            letter-spacing: 0.8px;
            box-shadow: 0 4px 12px rgba(0, 150, 199, 0.3);
        }

        .review-prompt {
            font-size: 22px;
            font-weight: 900;
            color: var(--text-main);
            margin: 24px 0 20px;
            line-height: 1.5;
            white-space: pre-line;
        }

        .review-input-box {
            font-size: 18px !important;
            text-align: center;
            padding: 16px !important;
            margin-bottom: 18px;
            border-radius: 50px !important;
            border: 3px solid var(--sky-blue) !important;
            box-shadow: 0 6px 20px rgba(72, 202, 228, 0.2);
        }

        .review-input-box[readonly] {
            background-color: #F8FAFC !important;
            cursor: default;
        }

        .review-feedback { font-size: 16px; font-weight: 900; min-height: 32px; margin-bottom: 10px; }
        .review-good { color: #38B000; }
        .review-bad { color: #FF4D6D; }
        .review-warn { color: #D97706; }
        .review-answer-hint { font-size: 15px; font-weight: 800; color: var(--magic-purple); margin-bottom: 18px; }

        .review-action-group {
            display: flex;
            justify-content: center;
            gap: 12px;
            margin-top: 20px;
            flex-wrap: wrap;
        }

        /* TOAST NOTIFICATION */
        .toast {
            position: fixed;
            bottom: 28px;
            right: 28px;
            background: #0B2545;
            color: white;
            padding: 14px 26px;
            border-radius: 50px;
            font-weight: 900;
            font-size: 14px;
            box-shadow: 0 12px 30px rgba(0,0,0,0.25), 0 0 15px rgba(72, 202, 228, 0.5);
            border: 2px solid var(--sky-blue);
            opacity: 0;
            transform: translateY(20px);
            transition: all 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
            z-index: 10000;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .toast.show { opacity: 1; transform: translateY(0); }

        .hidden { display: none !important; }

        /* LOADING SPINNER */
        .loading-spinner { display: none; align-items: center; justify-content: center; gap: 10px; font-size: 14px; font-weight: 800; color: var(--ocean-dark); margin-top: 12px; }
        .spinner { width: 20px; height: 20px; border: 3px solid #E0F7FA; border-top-color: var(--ocean-main); border-radius: 50%; animation: spin 0.8s linear infinite; }
        @keyframes spin { to { transform: rotate(360deg); } }

        /* RESPONSIVE CARD VIEW FOR MOBILE */
        @media (max-width: 850px) {
            .container { padding: 18px; }
            .header-bar { flex-direction: column; align-items: flex-start; }
            .header-actions { width: 100%; }
            .header-actions .btn { flex: 1; }
            
            table, thead, tbody, th, td, tr { display: block; }
            thead { display: none; }
            tr {
                margin-bottom: 18px;
                border: 2px solid var(--sky-blue);
                border-radius: var(--radius-md);
                padding: 14px;
                background: #FFFFFF;
                box-shadow: 0 4px 15px rgba(0,119,182,0.08);
            }
            td {
                border: none;
                padding: 8px 0;
                display: flex;
                justify-content: space-between;
                align-items: center;
            }
            td::before {
                content: attr(data-label);
                font-weight: 900;
                font-size: 12px;
                color: var(--text-sub);
                text-transform: uppercase;
                margin-right: 12px;
            }
        }
    &lt;/style&gt;
&lt;/head&gt;
