            difficulty: "medium"
        },
        {
            id: 3,
            word: "resilient",
            ipa: "/rɪˈzɪl.i.ənt/",
            pos: "adjective",
            meaningVi: "kiên cường, có khả năng phục hồi nhanh",
            synonyms: ["adaptable", "tough", "flexible"],
            collocations: [
                { 
                    phrase: "highly resilient", 
                    example: "Children are often highly resilient.",
                    exampleVi: "Trẻ em thường có khả năng thích ứng rất kiên cường." 
                },
                { 
                    phrase: "resilient economy", 
                    example: "Building a resilient economy is crucial.",
                    exampleVi: "Xây dựng một nền kinh tế kiên cường là rất quan trọng." 
                }
            ],
            example: "She is resilient enough to overcome any obstacle.",
            exampleVi: "Cô ấy đủ kiên cường để vượt qua mọi trở ngại.",
            correctCount: 0,
            wrongCount: 0,
            level: 0,
            nextReview: new Date().toISOString().split('T')[0],
            register: "General",
            tags: ["Psychology", "IELTS"],
            difficulty: "easy"
        }
    ];

    /* ===== STATE MANAGEMENT ===== */
    let hideOriginalWordMode = true; 
    let inlineAttemptsMap = {};      
    let reviewWrongAttempts = 0;     
    let currentAudioSpeed = 1.0;

    /* ===== DATA MIGRATION &amp; SANITIZATION ===== */
    function normalizeCollocations(collocations) {
        if (!Array.isArray(collocations)) return [];
        return collocations.map(c =&gt; {
            if (typeof c === 'string') {
                return { phrase: c, example: '', exampleVi: '' };
            } else if (typeof c === 'object' &amp;&amp; c !== null) {
                return {
                    phrase: c.phrase || c.text || 'Collocation',
                    example: c.example || '',
                    exampleVi: c.exampleVi || ''
                };
            }
            return { phrase: String(c), example: '', exampleVi: '' };
        });
    }

    function migrateData(item) {
        return Object.assign({
            id: Date.now() + Math.random(),
            word: "",
            ipa: "",
            pos: "noun",
            meaningVi: "Đang cập nhật",
            synonyms: [],
            collocations: [],
            example: "",
            exampleVi: "",
            correctCount: 0,
            wrongCount: 0,
            level: 0,
            nextReview: new Date().toISOString().split('T')[0],
            register: "General",
            tags: ["General"],
            difficulty: "medium"
        }, item, {
            collocations: normalizeCollocations(item.collocations),
            meaningVi: (item.meaningVi &amp;&amp; item.meaningVi.trim()) ? item.meaningVi : "Đang cập nhật nghĩa"
        });
    }

    let vocabList = [];
    try {
        const saved = JSON.parse(localStorage.getItem('smart_vocab_magical_v21'));
        vocabList = Array.isArray(saved) ? saved.map(migrateData) : initialVocab.map(migrateData);
    } catch(e) {
        vocabList = initialVocab.map(migrateData);
    }

    let currentPendingAIWord = null;
    let reviewQueue = [];
    let reviewIndex = 0;
    let reviewAnswered = false;
    let currentReviewItem = null;
    let currentReviewMode = 'recall';
    let currentSelectedText = "";

    /* ===== HELPERS &amp; ACTIVE RECALL MASKING ===== */
    function getTodayStr() { return new Date().toISOString().split('T')[0]; }
    
    function isDue(dateStr) { return !dateStr || dateStr &lt;= getTodayStr(); }

    function formatDateDisplay(dateStr) {
        if (!dateStr) return 'Chưa xếp';
        const today = getTodayStr();
        if (dateStr &lt;= today) return '🔥 Hôm nay';
        const parts = dateStr.split('-');
        return `${parts[2]}/${parts[1]}/${parts[0]}`;
    }

    function toast(msg) {
        const t = document.getElementById('toast');
        t.innerText = msg;
        t.classList.add('show');
        setTimeout(() =&gt; t.classList.remove('show'), 2800);
    }

    function setAudioSpeed(speed) {
        currentAudioSpeed = speed;
        toast(`🔊 Đã chỉnh tốc độ đọc: ${speed}x`);
        const btns = document.querySelectorAll('.speed-btn');
        btns.forEach(b =&gt; {
            b.classList.remove('active');
            if (b.innerText === speed + 'x') b.classList.add('active');
        });
    }

    function speak(text) {
        if ('speechSynthesis' in window &amp;&amp; text) {
            window.speechSynthesis.cancel();
            const u = new SpeechSynthesisUtterance(text);
            u.lang = 'en-US';
            u.rate = currentAudioSpeed || 0.9;
            window.speechSynthesis.speak(u);
        }
    }

    function toggleTrans(id) {
        const el = document.getElementById(id);
        if (el) el.style.display = (el.style.display === 'block') ? 'none' : 'block';
    }

    function saveData() {
        localStorage.setItem('smart_vocab_magical_v21', JSON.stringify(vocabList));
        renderTables();
    }

    function toggleHideOriginalMode() {
        hideOriginalWordMode = !hideOriginalWordMode;
        const btn = document.getElementById('toggle-hide-btn');
        btn.innerText = hideOriginalWordMode ? "🙈 Che từ gốc: ĐANG BẬT" : "👁️ Che từ gốc: ĐANG TẮT";
        renderTables();
        toast(hideOriginalWordMode ? "🙈 Đã bật Active Recall (Che từ gốc)" : "👁️ Đã hiện lại toàn bộ từ gốc");
    }

    function maskWordInText(text, targetWord) {
        if (!text || !targetWord) return text || '';
        if (!hideOriginalWordMode) return text;
        return maskWordInTextForce(text, targetWord);
    }

    function maskWordInTextForce(text, targetWord) {
        if (!text || !targetWord) return text || '';
        const escaped = targetWord.trim().replace(/[.*+?^${}()|[\]\\]/g, '\\$&amp;');
        const regex = new RegExp(`\\b${escaped}\\b`, 'gi');
        return text.replace(regex, '[______]');
    }

    /* ===== HIGHLIGHT / TEXT SELECTION EVENT LISTENER ===== */
    document.addEventListener('mouseup', handleTextSelection);

    function handleTextSelection(e) {
        const floatingBtn = document.getElementById('floating-add-btn');
        if (e.target.closest('#floating-add-btn') || e.target.closest('input')) return;

        const selection = window.getSelection();
        const text = selection ? selection.toString().trim() : "";

        if (text &amp;&amp; text.length &gt;= 2 &amp;&amp; text.length &lt;= 40 &amp;&amp; /^[a-zA-Z\s'-]+$/.test(text)) {
            currentSelectedText = text;
            document.getElementById('selected-word-label').innerText = text.length &gt; 15 ? text.substring(0, 12) + "..." : text;

            const range = selection.getRangeAt(0);
            const rect = range.getBoundingClientRect();

            floatingBtn.style.left = `${Math.min(window.innerWidth - 180, Math.max(10, rect.left + window.scrollX))}px`;
            floatingBtn.style.top = `${Math.max(10, rect.top + window.scrollY - 45)}px`;
            floatingBtn.style.display = 'flex';
        } else {
            floatingBtn.style.display = 'none';
        }
    }

    function addSelectedTextToInput() {
        if (!currentSelectedText) return;
        const inputEl = document.getElementById('ai-word-input');
        inputEl.value = currentSelectedText;
        document.getElementById('floating-add-btn').style.display = 'none';
        window.scrollTo({ top: 0, behavior: 'smooth' });
        generateWordDataAuto();
    }

    /* ===== AUTO TRANSLATE HELPER ===== */
    async function translateTextAuto(textEn) {
        if (!textEn) return "";
        const cleanKey = textEn.trim().toLowerCase();
        if (OVERRIDE_DICT[cleanKey]) return OVERRIDE_DICT[cleanKey];

        try {
            const res = await fetch(`https://api.mymemory.translated.net/get?q=${encodeURIComponent(textEn)}&amp;langpair=en|vi`);
            if (res.ok) {
                const data = await res.json();
                let trans = data?.responseData?.translatedText || "";
                if (trans &amp;&amp; OVERRIDE_DICT[trans.toLowerCase()]) return OVERRIDE_DICT[trans.toLowerCase()];
                return trans;
            }
        } catch(e) {}
        return "";
    }

    /* ===== AUTO VOCAB GENERATOR ===== */
    async function generateWordDataAuto() {
        const wordInput = document.getElementById('ai-word-input');
        const rawWord = wordInput.value.trim().toLowerCase();
        if (!rawWord) return;

        if (vocabList.some(v =&gt; v.word.toLowerCase() === rawWord)) {
            toast(`Từ "${rawWord}" đã có trong danh sách từ vựng của bạn!`);
            return;
        }

        document.getElementById('ai-loading').style.display = 'flex';
        document.getElementById('ai-preview').style.display = 'none';

        try {
            let ipa = "";
            let pos = "word";
            let synonyms = [];
            let exampleEn = "";

            try {
                const dictRes = await fetch(`https://api.dictionaryapi.dev/api/v2/entries/en/${encodeURIComponent(rawWord)}`);
                if (dictRes.ok) {
                    const dictData = await dictRes.json();
                    const entry = dictData[0];
                    if (entry) {
                        ipa = entry.phonetic || entry.phonetics?.find(p =&gt; p.text)?.text || "";
                        if (entry.meanings &amp;&amp; entry.meanings.length &gt; 0) {
                            pos = entry.meanings[0].partOfSpeech || "word";
                            synonyms = entry.meanings[0].synonyms ? entry.meanings[0].synonyms.slice(0, 3) : [];
                            const defWithEx = entry.meanings[0].definitions?.find(d =&gt; d.example);
                            if (defWithEx) exampleEn = defWithEx.example;
                        }
                    }
                }
            } catch(err) {}

            let meaningVi = await translateTextAuto(rawWord);
            if (!meaningVi || meaningVi.toLowerCase() === rawWord) {
                meaningVi = `Nghĩa của từ ${rawWord}`;
            }

            if (!exampleEn) {
                exampleEn = `It is essential to understand how to use ${rawWord} correctly.`;
            }

            let exampleVi = await translateTextAuto(exampleEn) || "Cần hiểu cách sử dụng từ này một cách chính xác.";

            const collocationsRaw = [
                { phrase: `${rawWord} process`, example: `We need to streamline the ${rawWord} process.` },
                { phrase: `effective ${rawWord}`, example: `They demonstrated an effective ${rawWord} strategy.` }
            ];

            const collocations = [];
            for (let c of collocationsRaw) {
                const cTrans = await translateTextAuto(c.example);
                collocations.push({
                    phrase: c.phrase,
                    example: c.example,
                    exampleVi: cTrans || "Bản dịch ví dụ collocation."
                });
            }

            let register = "General";
            if (rawWord.length &gt; 8 || pos === "adjective") register = "Academic";

            currentPendingAIWord = migrateData({
                word: rawWord,
                ipa: ipa || `/${rawWord}/`,
                pos: pos,
                meaningVi: meaningVi,
                synonyms: synonyms.length ? synonyms : ["related term"],
                collocations: collocations,
                example: exampleEn,
                exampleVi: exampleVi,
                correctCount: 0,
                wrongCount: 0,
                level: 0,
                nextReview: getTodayStr(),
                register: register,
                tags: ["General"],
                difficulty: "medium"
            });

            document.getElementById('prev-word').innerText = currentPendingAIWord.word;
