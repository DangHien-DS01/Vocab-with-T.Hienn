&lt;script&gt;
    /* ===== OVERRIDE DICTIONARY DỊCH CHUẨN ===== */
    const OVERRIDE_DICT = {
        "pipeline": "quy trình / hệ thống xử lý",
        "allocate": "phân bổ, cấp phát",
        "resilient": "kiên cường, linh hoạt",
        "abide by": "tuân thủ, làm theo",
        "framework": "khung làm việc, khuôn mẫu",
        "deployment": "triển khai"
    };

    /* ===== INITIAL VOCABULARY SEED DATA ===== */
    const initialVocab = [
        {
            id: 1,
            word: "allocate",
            ipa: "/ˈæl.ə.keɪt/",
            pos: "verb",
            meaningVi: "phân bổ, cấp phát",
            synonyms: ["assign", "distribute", "grant"],
            collocations: [
