    /* ===== COGNITIVE SRS MEMORY SCORE FORMULA ===== */
    function calculateMemoryScore(item) {
        const total = item.correctCount + item.wrongCount;
        if (total === 0) return 0;

        const accuracy = item.correctCount / total;
        const levelRatio = Math.min((item.level || 0) / 5, 1.0);

        let score = (accuracy * 0.3 + levelRatio * 0.7) * 100;

        const todayStr = getTodayStr();
        if (item.nextReview &amp;&amp; item.nextReview &lt; todayStr) {
            const diffTime = Math.abs(new Date(todayStr) - new Date(item.nextReview));
            const overdueDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));
            score -= overdueDays * 5; 
        }

        return Math.max(0, Math.min(100, Math.round(score)));
    }

    function getPosBadgeHTML(pos) {
        const p = (pos || '').toLowerCase();
        if (p.includes('noun') || p === 'n') return `&lt;span class="pos-badge pos-noun"&gt;Noun&lt;/span&gt;`;
        if (p.includes('verb') || p === 'v') return `&lt;span class="pos-badge pos-verb"&gt;Verb&lt;/span&gt;`;
        if (p.includes('adj')) return `&lt;span class="pos-badge pos-adj"&gt;Adj&lt;/span&gt;`;
        if (p.includes('adv')) return `&lt;span class="pos-badge pos-adv"&gt;Adv&lt;/span&gt;`;
        return `&lt;span class="pos-badge pos-other"&gt;${pos || 'Word'}&lt;/span&gt;`;
    }

    function getMemoryBadgeHTML(score, level) {
        if (score &gt;= 95 || level &gt;= 5) return `&lt;span class="mem-tag mem-tag-master"&gt;🟣 Thuộc lòng&lt;/span&gt;`;
        if (score &gt;= 70) return `&lt;span class="mem-tag mem-tag-good"&gt;🟢 Nhớ tốt&lt;/span&gt;`;
        if (score &gt;= 40) return `&lt;span class="mem-tag mem-tag-mid"&gt;🟡 Đang học&lt;/span&gt;`;
        return `&lt;span class="mem-tag mem-tag-low"&gt;🔴 Cần ôn&lt;/span&gt;`;
    }

